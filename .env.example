# --- Server-only secrets. NEVER expose these to the frontend. ---
# Leave the Google values empty to run in demo mode with synthetic data.

# OAuth 2.0 client (Google Cloud Console > APIs & Services > Credentials, type "Web application")
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Must be registered as an authorized redirect URI on the OAuth client.
# In dev the Vite server proxies /auth to the backend, so this stays same-origin.
GOOGLE_ADS_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Google Ads API developer token (Google Ads > Tools > API Center)
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional: manager (MCC) account ID without dashes, used as login-customer-id
# when an account is not reachable directly.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Google Ads API version
GOOGLE_ADS_API_VERSION=v25

# Where the browser is sent after the OAuth callback
APP_URL=http://localhost:5173
PORT=3001
# Long random string; used to sign the session cookie
SESSION_SECRET=change-me
